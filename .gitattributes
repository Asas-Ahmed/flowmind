# Normalize text files and let Git detect text automatically.
* text=auto

# Use LF line endings for source code and configuration files.
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
*.env.example text eol=lf

# Python and database files.
*.py        text eol=lf
*.pyi       text eol=lf
*.sql       text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf

# Shell and Docker files.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Windows-specific scripts should retain CRLF endings.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Treat common binary files as binary.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.mp3       binary
*.mp4       binary
*.webm      binary
*.mov       binary

# Office and design files.
*.doc       binary
*.docx      binary
*.xls       binary
*.xlsx      binary
*.ppt       binary
*.pptx      binary
*.fig       binary

# Model and serialized data files.
*.pkl       binary
*.joblib    binary
*.onnx      binary
*.pt        binary
*.pth       binary
*.cbm       binary
*.npy       binary
*.npz       binary

# Reduce noisy GitHub language statistics for generated and lock files.
package-lock.json linguist-generated=true
*.min.js          linguist-generated=true
*.min.css         linguist-generated=true
